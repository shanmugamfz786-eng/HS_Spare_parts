# ==============================================================================
# HS SPARE PARTS — ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL CREDENTIALS. COPY TO .env.local FOR LOCAL DEVELOPMENT.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Application URL
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=

# Authentication Secret (Minimum 32 characters)
AUTH_SECRET=

# Commerce & Localization Defaults
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN

# Payment Provider Configuration (Pending Owner Gateway Confirmation)
# Allowed: mock | razorpay | stripe | cashfree | phonepe
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional Services (Pending Owner Onboarding)
# EMAIL_FROM=
# RESEND_API_KEY=
# WHATSAPP_API_TOKEN=
